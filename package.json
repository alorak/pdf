{
  "name": "pdf-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:stress:model": "node --test stress/*.stress.mjs",
    "test:stress:capacity": "playwright test --config=playwright.stress.config.mjs",
    "test:stress:browser": "playwright test --config=playwright.perf.config.mjs",
    "test:stress:report": "node stress/report.mjs",
    "fixture:generate": "node scripts/generate-stress-pdf.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
